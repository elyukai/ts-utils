{
  "name": "@elyukai/utils",
  "version": "0.3.7",
  "description": "A set of JavaScript helper functions.",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "AUTHORS",
    "CHANGELOG.md"
  ],
  "exports": {
    "./*": "./dist/src/*.js"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node --import tsx --test",
    "lint": "eslint",
    "format": "prettier \"{src,test}/**/*.{ts,tsx}\" --write",
    "format:check": "prettier \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elyukai/ts-utils.git"
  },
  "author": "Lukas Obermann",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/elyukai/ts-utils/issues"
  },
  "homepage": "https://github.com/elyukai/ts-utils#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
